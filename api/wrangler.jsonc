{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sde-intern-task-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Add bindings here as you need them, then run `pnpm cf-typegen` to refresh `Env` types.
	//
	// Examples:
	//
	"d1_databases": [

		{
			"binding": "docodego_survey_db",
			"database_name": "docodego-survey-db",
			"database_id": "942ad47f-68e3-49f0-b3a5-74ebf48f85e6"
		}
	],
	//
	// "kv_namespaces": [
	//   { "binding": "SESSIONS", "id": "<id>" }
	// ],
	//  
	// "r2_buckets": [
	//   { "binding": "ASSETS", "bucket_name": "survey-builder-assets" }
	// ]
}